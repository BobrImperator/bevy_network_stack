From: Bartlomiej Dudzik <15948633+BobrImperator@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:00:00 +0100
Subject: [PATCH] Use Wayland as the Linux windowing and clipboard backend

`bevy_winit` was a default-features dependency, so its default `x11`
feature pulled the X11 backend (`x11rb`, `x11-dl`) into every
application that depends on bevy_egui. `manage_clipboard` also pulled
`arboard`, whose Linux clipboard always links `x11rb`, even with its
`wayland-data-control` feature.

Select no `bevy_winit` default features. On Linux and the BSDs, select
`bevy_winit`'s `wayland` backend instead, so bevy_egui still compiles
with a backend on those targets; elsewhere winit needs no backend
feature.

On Linux and the BSDs, `smithay-clipboard`, which bevy_egui already
tries first, becomes the only clipboard: `arboard` and `thread_local`
are selected only on the other native targets, and the arboard fallback
paths compile only there. Copying an image there logs the error the
smithay path already logged and does nothing.
---
 Cargo.toml |  6 +++--
 src/lib.rs | 69 ++++++++++++++++++++++++++++++++++++++++++------------
 2 files changed, 58 insertions(+), 17 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 5d4cb7b..0259ff2 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -105,7 +105,7 @@ bevy_reflect = { version = "0.20.0" }
 bevy_time = { version = "0.20.0" }
 bevy_shape = { version = "0.20.0" }
 bevy_window = { version = "0.20.0" }
-bevy_winit = { version = "0.20.0" }
+bevy_winit = { version = "0.20.0", default-features = false }
 bevy_utils = { version = "0.20.0", features = ["debug"] }
 winit = { version = "0.30", default-features = false }
 
@@ -134,11 +134,13 @@ bevy_ui_render = { version = "0.20.0", optional = true }
 bevy_picking = { version = "0.20.0", optional = true, features = ["mesh_picking"] }
 
 # `manage_clipboard` feature
-[target.'cfg(not(any(target_arch = "wasm32", target_os = "android")))'.dependencies]
+[target.'cfg(not(any(target_arch = "wasm32", target_os = "android", target_os="linux", target_os="dragonfly", target_os="freebsd", target_os="netbsd", target_os="openbsd")))'.dependencies]
 arboard = { version = "3.2.0", optional = true }
 thread_local = { version = "1.1.0", optional = true }
 [target.'cfg(any(target_os="linux", target_os="dragonfly", target_os="freebsd", target_os="netbsd", target_os="openbsd"))'.dependencies]
 smithay-clipboard = { version = "0.7.2", optional = true }
+# The windowing backend on these targets: Wayland, which `smithay-clipboard` already speaks.
+bevy_winit = { version = "0.20.0", default-features = false, features = ["wayland"] }
 
 [dev-dependencies]
 version-sync = "0.9.5"
